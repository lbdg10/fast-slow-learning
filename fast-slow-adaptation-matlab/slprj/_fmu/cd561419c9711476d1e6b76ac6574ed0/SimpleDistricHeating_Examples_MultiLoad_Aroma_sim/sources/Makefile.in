# Makefile generated by OpenModelica
CC=@CC@
AR=@AR@
CFLAGS=@CFLAGS@
LD=$(CC) -shared
# define OMC_LDFLAGS_LINK_TYPE env variable to override this
OMC_LDFLAGS_LINK_TYPE=static
LDFLAGS=@LDFLAGS@ @LIBS@
DLLEXT=@DLLEXT@
NEED_RUNTIME=@NEED_RUNTIME@
NEED_DGESV=@NEED_DGESV@
NEED_CMINPACK=@NEED_CMINPACK@
NEED_SUNDIALS=@NEED_SUNDIALS@
FMIPLATFORM=@FMIPLATFORM@
# Note: Simulation of the fmu with dymola does not work with -finline-small-functions (enabled by most optimization levels)
CPPFLAGS=@CPPFLAGS@

override CPPFLAGS += 

CFILES = SimpleDistricHeating_Examples_MultiLoad_Aroma_sim.c \
         SimpleDistricHeating_Examples_MultiLoad_Aroma_sim_functions.c \
         SimpleDistricHeating_Examples_MultiLoad_Aroma_sim_records.c \
         SimpleDistricHeating_Examples_MultiLoad_Aroma_sim_01exo.c \
         SimpleDistricHeating_Examples_MultiLoad_Aroma_sim_02nls.c \
         SimpleDistricHeating_Examples_MultiLoad_Aroma_sim_03lsy.c \
         SimpleDistricHeating_Examples_MultiLoad_Aroma_sim_04set.c \
         SimpleDistricHeating_Examples_MultiLoad_Aroma_sim_05evt.c \
         SimpleDistricHeating_Examples_MultiLoad_Aroma_sim_06inz.c \
         SimpleDistricHeating_Examples_MultiLoad_Aroma_sim_07dly.c \
         SimpleDistricHeating_Examples_MultiLoad_Aroma_sim_08bnd.c \
         SimpleDistricHeating_Examples_MultiLoad_Aroma_sim_09alg.c \
         SimpleDistricHeating_Examples_MultiLoad_Aroma_sim_10asr.c \
         SimpleDistricHeating_Examples_MultiLoad_Aroma_sim_11mix.c \
         SimpleDistricHeating_Examples_MultiLoad_Aroma_sim_12jac.c \
         SimpleDistricHeating_Examples_MultiLoad_Aroma_sim_13opt.c \
         SimpleDistricHeating_Examples_MultiLoad_Aroma_sim_14lnz.c \
         SimpleDistricHeating_Examples_MultiLoad_Aroma_sim_15syn.c \
         SimpleDistricHeating_Examples_MultiLoad_Aroma_sim_16dae.c \
         SimpleDistricHeating_Examples_MultiLoad_Aroma_sim_17inl.c \
         SimpleDistricHeating_Examples_MultiLoad_Aroma_sim_18spd.c \
         SimpleDistricHeating_Examples_MultiLoad_Aroma_sim_init_fmu.c \
         SimpleDistricHeating_Examples_MultiLoad_Aroma_sim_FMU.c
OFILES=$(CFILES:.c=.o)

RUNTIMEDIR=.
ifneq ($(NEED_DGESV),)
DGESV_OBJS = ./external_solvers/dgesv.o ./external_solvers/dgetrf.o ./external_solvers/dlamch.o ./external_solvers/ilaenv.o ./external_solvers/xerbla.o ./external_solvers/dgetf2.o ./external_solvers/dgetrs.o ./external_solvers/dlaswp.o ./external_solvers/ieeeck.o ./external_solvers/iparmq.o ./external_solvers/dgemm.o ./external_solvers/dger.o ./external_solvers/dscal.o ./external_solvers/dswap.o ./external_solvers/dtrsm.o ./external_solvers/idamax.o ./external_solvers/lsame.o ./external_solvers/i_nint.o ./external_solvers/pow_di.o ./external_solvers/s_cmp.o ./external_solvers/s_copy.o
endif
ifneq ($(NEED_CMINPACK),)
CMINPACK_OBJS=./external_solvers/enorm_.o ./external_solvers/hybrj_.o ./external_solvers/dpmpar_.o ./external_solvers/qrfac_.o ./external_solvers/qform_.o ./external_solvers/dogleg_.o ./external_solvers/r1updt_.o ./external_solvers/r1mpyq_.o
endif
ifneq ($(NEED_RUNTIME),)
RUNTIMEFILES=gc/memory_pool.o gc/omc_gc.o ./util/base_array.o ./util/boolean_array.o ./util/division.o ./util/doubleEndedList.o ./util/generic_array.o ./util/index_spec.o ./util/integer_array.o ./util/jacobian_util.o ./util/list.o ./util/modelica_string_lit.o ./util/modelica_string.o ./util/ModelicaUtilities.o ./util/omc_error.o ./util/omc_file.o ./util/omc_init.o ./util/omc_mmap.o ./util/omc_msvc.o ./util/omc_numbers.o ./util/parallel_helper.o ./util/rational.o ./util/real_array.o ./util/ringbuffer.o ./util/simulation_options.o ./util/string_array.o ./util/utility.o ./util/varinfo.o ./math-support/pivot.o ./simulation/omc_simulation_util.o ./simulation/options.o ./simulation/simulation_info_json.o ./simulation/simulation_omc_assert.o ./simulation/solver/delay.o ./simulation/solver/fmi_events.o ./simulation/solver/model_help.o ./simulation/solver/omc_math.o ./simulation/solver/spatialDistribution.o ./simulation/solver/stateset.o ./simulation/solver/synchronous.o ./simulation/solver/initialization/initialization.o ./meta/meta_modelica_catch.o ./simulation/solver/linearSystem.o ./simulation/solver/linearSolverLapack.o ./simulation/solver/linearSolverTotalPivot.o ./simulation/solver/nonlinearSolverHomotopy.o ./simulation/solver/nonlinearSolverHybrd.o ./simulation/solver/nonlinearValuesList.o ./simulation/solver/nonlinearSystem.o $(DGESV_OBJS) $(CMINPACK_OBJS)
endif
ifneq ($(NEED_SUNDIALS),)
FMISUNDIALSFILES=
LDFLAGS+=-Wl,-Bstatic -lsundials_cvode -lsundials_nvecserial -Wl,-Bdynamic
endif

PHONY: SimpleDistricHeating_Examples_MultiLoad_Aroma_sim_FMU
SimpleDistricHeating_Examples_MultiLoad_Aroma_sim_FMU: nozip
	cd .. && rm -f ../SimpleDistricHeating_Examples_MultiLoad_Aroma_sim.fmu && zip -r ../SimpleDistricHeating.Examples.MultiLoad.Aroma_sim.fmu *
nozip: SimpleDistricHeating_Examples_MultiLoad_Aroma_sim_functions.h SimpleDistricHeating_Examples_MultiLoad_Aroma_sim_literals.h $(OFILES) $(RUNTIMEFILES) $(FMISUNDIALSFILES)
	$(CXX) -shared -I. -o SimpleDistricHeating_Examples_MultiLoad_Aroma_sim$(DLLEXT) $(RUNTIMEFILES) $(FMISUNDIALSFILES) $(OFILES) $(CPPFLAGS) -L"C:/Users/laura/OneDrive - Politecnico di Milano/Tesi/Modelica"   $(CFLAGS) $(LDFLAGS) -llis -Wl,--kill-at
	mkdir.exe -p ../binaries/win64
	dlltool -d SimpleDistricHeating_Examples_MultiLoad_Aroma_sim.def --dllname SimpleDistricHeating_Examples_MultiLoad_Aroma_sim$(DLLEXT) --output-lib SimpleDistricHeating_Examples_MultiLoad_Aroma_sim.lib --kill-at
	cp SimpleDistricHeating_Examples_MultiLoad_Aroma_sim$(DLLEXT) SimpleDistricHeating_Examples_MultiLoad_Aroma_sim.lib SimpleDistricHeating_Examples_MultiLoad_Aroma_sim_FMU.libs ../binaries/win64/
	rm -f *.o SimpleDistricHeating_Examples_MultiLoad_Aroma_sim$(DLLEXT) $(OFILES) $(RUNTIMEFILES) $(FMISUNDIALSFILES)
	cd .. && rm -f ../SimpleDistricHeating_Examples_MultiLoad_Aroma_sim.fmu && zip -r ../SimpleDistricHeating.Examples.MultiLoad.Aroma_sim.fmu *

